# Copy to .env and fill what you need. Everything is optional for local use —
# the terminal runs with zero configuration; only the AI assistant needs a key.

# Shared secret between the web and api containers. If unset, one is generated
# on first run and stored in the data volume (fine for local use; set it
# explicitly for a real deployment).
# API_KEY=

# The browser origin the API may be called from. Default: http://localhost:3000
# WEB_ORIGIN=

# Set to 1 only when exactly one trusted reverse proxy sits in front of the web
# service and sets X-Forwarded-For from the real client.
# TRUST_PROXY=

# ---- AI assistant (optional) ----
# Any OpenAI-compatible chat endpoint works. Example: Venice.
# LLM_API_URL=https://api.venice.ai/api/v1
# LLM_API_KEY=your-api-key-here
# LLM_MODEL=claude-haiku-5-5
